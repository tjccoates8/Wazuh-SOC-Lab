<group name="windows,sysmon,powershell,">

  <rule id="100002" level="8">
    <if_sid>92027</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)Get-LocalUser</field>
    <description>PowerShell Local Account Enumeration Detected</description>
    <mitre>
      <id>T1087.001</id>
    </mitre>
    <group>account_discovery,powershell_activity,</group>
  </rule>

</group>
<group name="windows,powershell,">

  <rule id="100003" level="8">
    <if_sid>91802</if_sid>
    <field name="win.system.eventID">^4104$</field>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)Get-LocalUser</field>
    <description>PowerShell Script Block - Local Account Enumeration Detected</description>
    <mitre>
      <id>T1087.001</id>
    </mitre>
    <group>account_discovery,powershell_activity,</group>
  </rule>

</group>
<group name="windows,authentication_failed,">

  <rule id="100004" level="10" frequency="5" timeframe="60">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>Multiple failed Windows login attempts detected - Possible Brute Force</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>

</group>
